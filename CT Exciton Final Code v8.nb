f0a0b6aeed16"],

Cell["\<\
This block imports one MD frame (npt.gro), parses atom lists for P3HT and \
IDTBR, and converts coordinates from nm to Angstrom for the energy model.\
\>", "Text",
 CellChangeTimes->{{3.996000000000003*^9, 
  3.994449302163314*^9}},ExpressionUUID->"b58982ba-a3de-4445-9d38-\
3081b220d13c"],

Cell["\<\
Importing molecular configurations from a single frame of molecular dynamics \
simulation\
\>", "Text",
 CellChangeTimes->{{3.9002541183376837`*^9, 3.900254123199049*^9}, {
  3.993747098317546*^9, 
  3.993747122344501*^9}},ExpressionUUID->"1854b482-a6af-4437-a727-\
53f1baec53fd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"importFrame", "[", "fName_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"frame", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"fName", ",", "\"\<Table\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nAtoms", "=", 
      RowBox[{"frame", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lBox3D", "=", 
      RowBox[{"10", " ", 
       RowBox[{"frame", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Importing", " ", "P3HT", " ", "24"}], "-", 
       RowBox[{"mers", 
        RowBox[{"(", "128", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"atoms1", "=", 
      RowBox[{"frame", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"3", ";;", "10001"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "4", ",", "5", ",", "6"}], "}"}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"atoms2", "=", 
      RowBox[{"frame", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"10002", ";;", "33794"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3", ",", "4", ",", "5"}], "}"}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"atoms", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"atoms1", ",", "atoms2"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"atoms", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"2", ";;", 
          RowBox[{"-", "1"}]}]}], "]"}], "]"}], "*=", "10"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newNames", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\"\<CA\>\"", ",", "\"\<CA\>\"", ",", "\"\<CA\>\"", ",", 
           "\"\<CA\>\"", ",", "\"\<S\>\"", ",", "\"\<C2\>\"", ",", 
           "\"\<C2\>\"", ",", "\"\<C2\>\"", ",", "\"\<C2\>\"", ",", 
           "\"\<C2\>\"", ",", "\"\<C2\>\""}], "}"}], ",", 
         RowBox[{"128", "*", "24"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"atoms", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "=", "newNames"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Importing", " ", "IDTBR", " ", "molecules", " ", 
       RowBox[{"(", "300", ")"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"idtbrAtoms", "=", 
      RowBox[{"frame", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"33795", ";;", 
          RowBox[{"-", "2"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3", ",", "4", ",", "5"}], "}"}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"idtbrAtoms", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"2", ";;", 
          RowBox[{"-", "1"}]}]}], "]"}], "]"}], "*=", "10"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"idtbrNames", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\"\<C\>\"", ",", "\"\<C\>\"", ",", "\"\<N\>\"", ",", "\"\<S\>\"", 
           ",", "\"\<C\>\"", ",", "\"\<C\>\"", ",", "\"\<S\>\"", ",", 
