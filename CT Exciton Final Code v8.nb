  RowBox[{"ePol", "[", 
   RowBox[{"psiL_", ",", "tL_", ",", "int_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"psi", ",", "qVals"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"psi", "=", 
      RowBox[{"psiL", "/", 
       RowBox[{"Norm", "[", "psiL", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qVals", "=", 
      RowBox[{"psi", "^", "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], 
       RowBox[{"Total", "[", 
