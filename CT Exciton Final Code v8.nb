           ",", "\"\<C\>\"", ",", "\"\<C\>\"", ",", "\"\<C\>\"", ",", 
           "\"\<C\>\"", ",", "\"\<C\>\"", ",", "\"\<C\>\"", ",", 
           "\"\<C\>\""}], "}"}], ",", "300"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"idtbrAtoms", "[", 
