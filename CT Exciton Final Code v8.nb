Cell["Separated CT exciton", "Text",
 CellChangeTimes->{{3.950224324975298*^9, 
  3.950224334734671*^9}},ExpressionUUID->"52c0d566-50d7-44cb-9fdd-\
cc1e15346dab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CTexctionMin2", "[", 
   RowBox[{"psiE0_", ",", "psiH0_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"psiEG", "=", 
      RowBox[{"psiE0", "/", 
       RowBox[{"Norm", "[", "psiE0", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"psiHG", "=", 
      RowBox[{"psiH0", "/", 
       RowBox[{"Norm", "[", "psiH0", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"argsE", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"psiE", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "14"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"argsH", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"psiH", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "14"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"guessElec", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"argsE", ",", "psiEG"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"guessHole", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"argsH", ",", "psiHG"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"guesses", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        StyleBox["guessElec",
         FontWeight->"Bold"], ",", 
        StyleBox["guessHole",
         FontWeight->"Bold"]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"holeONp3ht", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"argsH", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "7"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"elecONidtbr", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"argsE", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "8", ",", "14"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"FindMinimum", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CTexctionE", "[", 
          RowBox[{"argsE", ",", "argsH", ",", "k"}], "]"}], ",", 
         RowBox[{
          RowBox[{"argsE", ".", "argsE"}], "==", "1."}], ",", 
         RowBox[{
          RowBox[{"argsH", ".", "argsH"}], "==", "1."}], ",", 
         RowBox[{"elecONidtbr", ">", "0.999"}], ",", 
         RowBox[{"holeONp3ht", ">", "0.999"}]}], "}"}], ",", "guesses"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  RowBox[{"(*", 
   RowBox[{"CT", " ", "exciton", " ", "separated", " ", "version"}], 
   "*)"}]}]], "Input",
 InitializationCell->True,
