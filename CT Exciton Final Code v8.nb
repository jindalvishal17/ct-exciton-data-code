Cell[BoxData[
 RowBox[{
  RowBox[{"matCoulIntCT", "[", "posns_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "mat", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mat", "=", 
      RowBox[{"eFac", " ", 
       RowBox[{"Outer", "[", 
        RowBox[{
         RowBox[{"0", "&"}], ",", "posns", ",", "posns", ",", "1"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "!=", "j"}], ",", 
         RowBox[{
          RowBox[{"mat", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"eFac", "/", 
            RowBox[{"Norm", "[", 
             RowBox[{"dpbc", "[", 
              RowBox[{
               RowBox[{"posns", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "-", 
               RowBox[{"posns", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}]}], "*", 
           RowBox[{"Erf", "[", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"dpbc", "[", 
               RowBox[{
                RowBox[{"posns", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "-", 
                RowBox[{"posns", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"deltaCT", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "+", 
                 RowBox[{"deltaCT", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "/", "2"}], 
              ")"}]}], "]"}]}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "14"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "14"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"mat", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
        RowBox[{"eFac", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sqrt", "[", "Pi", "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"deltaCT", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "/", "2"}], ")"}]}], ")"}]}]}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "14"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "mat"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
