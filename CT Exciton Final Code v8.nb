            RowBox[{"-", "1"}]}], "]"}], "]"}]}], " ", "]"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"1", "/", "eps"}]}], ")"}], 
