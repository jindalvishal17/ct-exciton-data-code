Cell[BoxData[
 RowBox[{
  RowBox[{"drawInterfaceContact", "[", "n_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mid1", ",", "mid2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"mid1", ",", "mid2"}], "}"}], "=", 
      RowBox[{"GetCloseContactRingPair", "[", "n", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ringCenter", "[", 
      RowBox[{"p3htAtoms", "[", "mid1", "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ListPointPlot3D", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"nearestImage", "[", 
               RowBox[{
                RowBox[{"ringCenter", "[", 
                 RowBox[{"idbAtoms", "[", "mid2", "]"}], "]"}], ",", "#"}], 
               "]"}], "&"}], "/@", 
             RowBox[{"p3htAtoms", "[", "i", "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"mid1", "-", "3"}], ",", 
              RowBox[{"mid1", "+", "3"}]}], "}"}]}], "]"}], "//", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"#", ",", "1"}], "]"}], "&"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"rh1Atoms", "[", "mid2", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"btd1Atoms", "[", "mid2", "]"}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"idt1Atoms", "[", "mid2", "]"}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"idbAtoms", "[", "mid2", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"idt2Atoms", "[", "mid2", "]"}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"btd2Atoms", "[", "mid2", "]"}], ",", "\[IndentingNewLine]", 
         
         RowBox[{"rh2Atoms", "[", "mid2", "]"}]}], "\[IndentingNewLine]", 
        "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"pbc3D", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"pbc3D", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
