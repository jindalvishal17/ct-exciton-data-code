Cell[CellGroupData[{

Cell["Function to get hopping term between two monomer", "Subsubsection",
 CellChangeTimes->{{3.949522570488324*^9, 
  3.9495225935270643`*^9}},ExpressionUUID->"a56fe1e6-5116-449a-bad9-\
f9d996f9cc6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tDist", "[", 
    RowBox[{"eA_", ",", "eB_", ",", "eABdist_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "dE", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dE", "=", 
       RowBox[{"eA", "+", "eB", "-", 
        RowBox[{"2", "eABdist"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{
         SuperscriptBox["dE", "2"], "-", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"eA", "-", "eB"}], ")"}], "2"]}], "]"}], "/", "2"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.94952260566335*^9, 3.949522650228898*^9}, {
  3.949522960331477*^9, 3.9495229642441196`*^9}, {3.949523130227488*^9, 
  3.949523253372983*^9}, {3.9495233924943943`*^9, 3.949523392782853*^9}, {
  3.94957842589062*^9, 3.949578426251852*^9}, {3.994436234787477*^9, 
  3.994436235140929*^9}},
 CellLabel->
  "In[1765]:=",ExpressionUUID->"8ed74eb6-f68d-443a-9099-d2282c7641ac"],

Cell["\<\
IDT is bridged three monomer entity, the bond between Thio-Ben is thus planar\
\
\>", "Text",
 CellChangeTimes->{{3.949581983175192*^9, 3.9495820343985653`*^9}, {
  3.949582073768897*^9, 
  3.9495820770815163`*^9}},ExpressionUUID->"959b058e-2d29-476b-ad87-\
5905315b7948"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pOptAnion", "=", 
   RowBox[{"fac", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "784.147882137"}], "+", "784.166171694"}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"pOptCation", "=", 
   RowBox[{"fac", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "783.881088822"}], "+", "784.166171694"}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"tHoleThBen", "=", 
   RowBox[{"tDist", "[", 
    RowBox[{"eCationThio", ",", "eCationBen", ",", 
     StyleBox["pOptCation",
      FontWeight->"Plain"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tElecThBen", "=", 
