Cell["PBC functions", "Text",
 CellChangeTimes->{{3.8884929784202747`*^9, 3.88849298257351*^9}, 
   3.888493023693062*^9},ExpressionUUID->"051546a3-d74d-4faa-848f-\
b3b5f26c7157"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pbc", "[", "r_", "]"}], ":=", 
   RowBox[{"Mod", "[", 
    RowBox[{"r", ",", "pbc3D"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dpbc", "[", "dr_", "]"}], ":=", 
   RowBox[{"Mod", "[", 
    RowBox[{"dr", ",", "pbc3D", ",", 
     RowBox[{
      RowBox[{"-", "pbc3D"}], "/", "2"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nearestImage", "[", 
    RowBox[{"r0_", ",", "r_"}], "]"}], ":=", 
   RowBox[{"r0", "+", 
    RowBox[{"dpbc", "[", 
     RowBox[{"r", "-", "r0"}], "]"}]}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.888492984852249*^9, 3.888492992032178*^9}, {
  3.888493025515921*^9, 3.888493039754241*^9}, {3.888493076748562*^9, 
  3.888493098927574*^9}, {3.948197209642434*^9, 3.94819721254144*^9}},
 CellLabel->
  "In[1666]:=",ExpressionUUID->"5b3c21ce-abec-4f03-9e6c-18a97438ec19"],

Cell["Finding center of ring given the list of atoms in the ring", "Text",
 CellChangeTimes->{{3.9481941824281693`*^9, 
  3.948194211944394*^9}},ExpressionUUID->"8faf894c-4d7d-4b4c-82eb-\
4db555e8e8a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ringCenter", "[", "atomList_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"posns", "=", "atomList"}], ";", "\[IndentingNewLine]", 
     RowBox[{"newPosns", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"nearestImage", "[", 
         RowBox[{
          RowBox[{"posns", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
       "posns"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pbc", "[", 
      RowBox[{"Mean", "[", "newPosns", "]"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.888493127558351*^9, 3.888493157490162*^9}, {
   3.8884931886819553`*^9, 3.888493284791697*^9}, {3.88849331943155*^9, 
