Cell["Chain # from ring #", "Text",
 CellChangeTimes->{{3.90025474147024*^9, 
  3.9002547455856524`*^9}},ExpressionUUID->"b1fa2196-14a3-42fc-978d-\
13e70fca7825"],

Cell[BoxData[
 RowBox[{
  RowBox[{"nChain", "[", "k_", "]"}], ":=", 
  RowBox[{"Ceiling", "[", 
   RowBox[{"k", "/", "24"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.88995021648671*^9, 3.8899502317440643`*^9}, {
  3.911374866206091*^9, 3.9113748665415373`*^9}},
 CellLabel->
  "In[1675]:=",ExpressionUUID->"5692e06c-0b19-4ebb-876e-af89e006b84e"],

Cell["Boolean function identifying chain ends", "Text",
 CellChangeTimes->{{3.900254748861655*^9, 
  3.900254756915181*^9}},ExpressionUUID->"fa2aa20e-2c29-4652-8811-\
1694fbfa2a82"],

Cell[BoxData[
 RowBox[{
  RowBox[{"isEnd", "[", "k_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Mod", "[", 
       RowBox[{"k", ",", "24", ",", "1"}], "]"}], "==", "1"}], "||", 
     RowBox[{
      RowBox[{"Mod", "[", 
       RowBox[{"k", ",", "24", ",", "1"}], "]"}], "==", "24"}]}], ",", "True",
     ",", "False"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.8899504868026743`*^9, 3.889950560762808*^9}, {
  3.911374869276637*^9, 3.9113748789550877`*^9}},
 CellLabel->
  "In[1676]:=",ExpressionUUID->"9a3d3fb6-a8fe-44d5-923b-38763f342e03"],

Cell["Finding close-contacts", "Text",
 CellChangeTimes->{{3.9482010650129147`*^9, 
  3.948201072306574*^9}},ExpressionUUID->"58bc5f8f-b686-40d2-a4f7-\
24c9e7a4ca1f"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "find", " ", "close", " ", "contacts", " ", 
     "between", " ", "Thiophene", " ", "and", " ", "BTD", " ", "rings"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"findCloseContacts", "[", 
      RowBox[{"k_", ",", "max_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"thiopheneCenter", ",", "closeBTDs", ",", "indexPairs"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Get", " ", "the", " ", "center", " ", "of", " ", "the", " ", 
         "current", " ", "Thiophene", " ", "ring"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"thiopheneCenter", "=", 
         RowBox[{"ccListP3HT", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Find", " ", "BTD", " ", "rings", " ", "within", " ", "the", " ", 
          "cutoff", " ", "distance"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"closeBTDs", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{"ccListBTD", ",", "#"}], "]"}], "&"}], "/@", 
           RowBox[{"Select", "[", 
            RowBox[{"ccListBTD", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Norm", "[", 
                RowBox[{"dpbc", "[", 
                 RowBox[{"#", "-", "thiopheneCenter"}], "]"}], "]"}], "<=", 
               "max"}], "&"}]}], "]"}]}], "//", "Flatten"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Generate", " ", "index", " ", "pairs", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Thiophene", " ", "index"}], ",", 
            RowBox[{"BTD", " ", "index"}]}], ")"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"indexPairs", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"k", ",", "#"}], "}"}], "&"}], "/@", "closeBTDs"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Return", " ", "the", " ", "index", " ", "pairs"}], "*)"}], 
        "\[IndentingNewLine]", "indexPairs"}]}], "]"}]}], ";"}]}], 
  "Code"]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9482010740063963`*^9, 3.94820107401339*^9}, 
   3.9482011283720303`*^9, {3.948201188385004*^9, 3.948201199299386*^9}, {
   3.948201425491578*^9, 3.948201473734424*^9}, {3.948202746769411*^9, 
   3.9482027470779743`*^9}, {3.9482875491568527`*^9, 3.9482875613227863`*^9}},
 
 CellLabel->
  "In[1677]:=",ExpressionUUID->"cd56ec88-c233-4856-b68d-e3a29f8b4a74"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Find", " ", "all", " ", "close", " ", "contacts", " ", "for", " ", 
     "Thiophene"}], "-", 
    RowBox[{
    "BTD", " ", "rings", " ", "within", " ", "a", " ", "cutoff", " ", "of", 
     " ", "5", " ", "units"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ThioBTDcloseContacts", "=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"findCloseContacts", "[", 
         RowBox[{"#", ",", "5."}], "]"}], "&"}], ",", 
       RowBox[{"Length", "[", "ccListP3HT", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Flatten", " ", "the", " ", "list", " ", "of", " ", "close", " ", 
     "contacts", " ", "to", " ", "remove", " ", "empty", " ", "entries"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"ThioBTDcloseContacts", "=", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"ThioBTDcloseContacts", ",", "1"}], "]"}], ",", 
       RowBox[{"{", "}"}]}], "]"}]}], ";"}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9482010740063963`*^9, 3.94820107401339*^9}, {
   3.9482011283720303`*^9, 3.948201135360772*^9}, {3.9482027730176067`*^9, 
   3.948202800169178*^9}, {3.948203241546336*^9, 3.948203258753014*^9}, 
   3.94820377488977*^9, {3.948287603718092*^9, 3.9482876310491457`*^9}, {
   3.948288183936524*^9, 3.948288185794264*^9}},
 CellLabel->
  "In[1678]:=",ExpressionUUID->"0172a47c-0135-47a2-af66-a640a023f6d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ThioBTDpairList", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"ThioBTDcloseContacts", ",", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"isEnd", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "||", 
         RowBox[{"isEnd", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "-", "2"}], "]"}], "||", 
         RowBox[{"isEnd", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "+", "2"}], "]"}]}], ")"}]}], 
      "&"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.948205266946206*^9, 3.948205268716671*^9}, {
   3.9482053550981083`*^9, 3.948205361720292*^9}, {3.948205459159841*^9, 
   3.948205492355771*^9}, {3.948205548823119*^9, 3.948205556201304*^9}, {
   3.948205605866132*^9, 3.948205680724544*^9}, {3.948206551983934*^9, 
   3.948206597638835*^9}, {3.948206634008275*^9, 3.948206645672616*^9}, 
   3.948208460733828*^9, 3.948208505618702*^9, {3.948208648040827*^9, 
   3.948208665641522*^9}, {3.948208899391946*^9, 3.948208919931127*^9}, {
   3.9482882288523397`*^9, 3.948288232897946*^9}},
 CellLabel->
  "In[1680]:=",ExpressionUUID->"f4c8fa33-1998-486b-864b-3fb74160a93a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", "ThioBTDpairList", "]"}]], "Input",
 CellChangeTimes->{{3.9482298699438963`*^9, 3.948229873222706*^9}, 
   3.948288267891699*^9},
 CellLabel->
  "In[1681]:=",ExpressionUUID->"5f02184a-ba49-41a7-aa80-7affde77c44a"],

Cell[BoxData["237"], "Output",
 CellChangeTimes->{{3.948229870470209*^9, 3.948229873496488*^9}, 
   3.94828826937327*^9, 3.949230409468616*^9, 3.952164641983527*^9, 
   3.95218781754876*^9, 3.9538936736667347`*^9, 3.965563137575158*^9, 
   3.968104985609521*^9, 3.968933814117977*^9, 3.97014330763046*^9, 
   3.989007929661192*^9, 3.994435647901209*^9},
 CellLabel->
  "Out[1681]=",ExpressionUUID->"e8147cc1-925d-4699-ad50-9d9afc80d53f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Function to calculate close contact pair {p3ht, idtbr} to get molecular \
geometries\
\>", "Subsubsection",
 CellChangeTimes->{{3.949586224866228*^9, 3.949586280205039*^9}, {
  3.949586726756214*^9, 3.949586770976243*^9}, {3.994435675212275*^9, 
  3.9944356756549063`*^9}},ExpressionUUID->"c5089711-239c-4427-99e0-\
cb5a9515cda5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GetCloseContactRingPair", "[", "i_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ThioNo", ",", "BTDno", ",", "IDTBRno"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ThioNo", ",", "BTDno"}], "}"}], "=", 
       RowBox[{"ThioBTDpairList", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"IDTBRno", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"BTDno", ">", "300"}], ",", 
