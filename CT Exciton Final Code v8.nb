Cell[CellGroupData[{

Cell["\<\
Figure 10: Scatter plot comparing CT exciton energy and IDTBR exciton energy \
for each
donor\[Dash]acceptor configuration. The red dashed line indicates equal \
energy.\
\>", "Subsection",
 CellChangeTimes->{
  3.994439403789784*^9},ExpressionUUID->"88bb62ac-54fb-4bf4-9d02-\
5f18c8c63a0a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"min", "=", 
   RowBox[{"Min", "[", 
    RowBox[{
     RowBox[{"Min", "[", "CTexcitonEnergyList", "]"}], ",", 
     RowBox[{"Min", "[", "IDTBRexcitonEnergyList", "]"}]}], "]"}]}], 
  ";"}], "\n", 
