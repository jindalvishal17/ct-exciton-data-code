              RowBox[{"pbc3D", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], "}"}]}], ","}], 
        "*)"}], 
       RowBox[{"BoxRatios", "->", "Automatic"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
         "Orange", ",", "Cyan", ",", "Green", ",", "Cyan", ",", "Cyan", ",", 
          "Cyan", ",", "Green", ",", "Cyan"}], "}"}]}]}], "]"}]}]}], 
   "]"}]}]], "Input",
