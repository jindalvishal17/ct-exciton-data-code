Cell[BoxData[
 RowBox[{
  RowBox[{"CTexctionMin3", "[", 
   RowBox[{"psiE0_", ",", "psiH0_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"psiEG", "=", 
      RowBox[{"psiE0", "/", 
       RowBox[{"Norm", "[", "psiE0", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"psiHG", "=", 
      RowBox[{"psiH0", "/", 
       RowBox[{"Norm", "[", "psiH0", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"argsE", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"psiE", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "14"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"argsH", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"psiH", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "14"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"guessElec", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"argsE", ",", "psiEG"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"guessHole", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"argsH", ",", "psiHG"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"guesses", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        StyleBox["guessElec",
         FontWeight->"Bold"], ",", 
        StyleBox["guessHole",
         FontWeight->"Bold"]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"holeONibtbr", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"argsH", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "8", ",", "14"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"elecONidtbr", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"argsE", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "8", ",", "14"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"FindMinimum", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CTexctionE", "[", 
          RowBox[{"argsE", ",", "argsH", ",", "k"}], "]"}], ",", 
         RowBox[{
          RowBox[{"argsE", ".", "argsE"}], "==", "1."}], ",", 
         RowBox[{
          RowBox[{"argsH", ".", "argsH"}], "==", "1."}], ",", 
         RowBox[{"elecONidtbr", "==", "1."}], " ", ",", 
         RowBox[{"holeONibtbr", "==", "1."}]}], "}"}], ",", "guesses"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  RowBox[{"(*", " ", 
   RowBox[{"exciton", " ", "on", " ", "IDTBR", " ", "version"}], 
   "*)"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.7509376093360023`*^9, 3.750937856306356*^9}, {
