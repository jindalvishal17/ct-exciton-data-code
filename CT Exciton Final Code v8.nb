Cell[CellGroupData[{

Cell["\<\

Low-energy CT state\
\>", "Subsubsection",
 CellChangeTimes->{{3.989008545156698*^9, 
  3.989008566544014*^9}},ExpressionUUID->"250fa32b-705f-4c6a-a1b4-\
1613ae846c58"],

Cell[TextData[{
 "1. A scatter plot, of the computed CT state energy, versus the sum of ",
 StyleBox["the two one-body energies (i.e., the electron and hole separately, \
with no Coulomb term, and no medium polarization term)",
  FontWeight->"Bold"],
 ".  This tests the idea is that \[OpenCurlyDoubleQuote]straight chains make \
good CT states\[CloseCurlyDoubleQuote], and the sum of the one-body energies \
is an indicator of how straight the chains are.  \n\n2. A scatter plot of the \
computed CT state energy, versus the Coulomb energy (electron-hole \
interaction, plus medium polarization energy).  This tests the alternative \
idea that \[OpenCurlyDoubleQuote]strong Coulomb attraction makes good CT \
states\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{
  3.9890085413824167`*^9, {3.989008578208971*^9, 3.989008601210425*^9}, {
   3.9890093132312183`*^9, 
   3.989009316009893*^9}},ExpressionUUID->"cefbc868-aa71-41c7-867a-\
b66755fbea42"],

Cell[TextData[StyleBox["Total CT exciton energy = Total Kinetic E + Coulomb E \
+ Polarization E", "Subsubsection"]], "Text",
 CellChangeTimes->{{3.919525684582096*^9, 3.919525703089033*^9}, {
  3.919525806975842*^9, 
  3.919525863707773*^9}},ExpressionUUID->"22edeb75-fbd9-4eb4-a54c-\
384e8a40d75e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CTSolve", "[", "k_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "res", ",", "sol", ",", "psiEopt", ",", "psiHopt", ",", "qElec", ",", 
      "qHole", ",", "qNet", ",", "eCoulOpt", ",", "ePolzOpt", ",", "eKEOpt", 
      ",", "holeKE", ",", "elecKE"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"psiEG", "=", 
      RowBox[{"psiEfull", "/", 
       RowBox[{"Norm", "[", "psiEfull", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"psiHG", "=", 
      RowBox[{"psiHfull", "/", 
       RowBox[{"Norm", "[", "psiHfull", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"argsE", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"psiE", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "14"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"argsH", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"psiH", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "14"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"guessElec", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"argsE", ",", "psiEG"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"guessHole", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"argsH", ",", "psiHG"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"guesses", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        StyleBox["guessElec",
         FontWeight->"Bold"], ",", 
        StyleBox["guessHole",
         FontWeight->"Bold"]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"holeONp3ht", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"argsH", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "7"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"elecONidtbr", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"argsE", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "^", "2"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "8", ",", "14"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"res", "=", 
      RowBox[{"FindMinimum", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"CTexctionE", "[", 
           RowBox[{"argsE", ",", "argsH", ",", "k"}], "]"}], ",", 
          RowBox[{
           RowBox[{"argsE", ".", "argsE"}], "==", "1"}], ",", 
          RowBox[{
           RowBox[{"argsH", ".", "argsH"}], "==", "1"}], ",", 
          RowBox[{"elecONidtbr", ">", "0.999"}], ",", 
          RowBox[{"holeONp3ht", ">", "0.999"}]}], "}"}], ",", "guesses"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"res", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"psiEopt", "=", 
      RowBox[{"argsE", "/.", " ", "sol"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"psiHopt", "=", 
      RowBox[{"argsH", "/.", " ", "sol"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eKEOpt", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"psiEopt", ".", 
         RowBox[{"matKEelecCT", "[", "k", "]"}], ".", "psiEopt"}], ")"}], " ",
        "-", " ", 
       RowBox[{"(", 
        RowBox[{"psiHopt", ".", 
         RowBox[{"matKEholeCT", "[", "k", "]"}], ".", "psiHopt"}], ")"}]}]}], 
     ";", " ", "\[IndentingNewLine]", 
     RowBox[{"elecKE", " ", "=", 
      RowBox[{"(", 
       RowBox[{"psiEopt", ".", 
        RowBox[{"matKEelecCT", "[", "k", "]"}], ".", "psiEopt"}], ")"}]}], 
     " ", ";", "\[IndentingNewLine]", 
     RowBox[{"holeKE", " ", "=", 
      RowBox[{"-", " ", 
       RowBox[{"(", 
        RowBox[{"psiHopt", ".", 
         RowBox[{"matKEholeCT", "[", "k", "]"}], ".", "psiHopt"}], ")"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"qElec", "=", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"psiEopt", "^", "2"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"qHole", "=", 
      RowBox[{"psiHopt", "^", "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qNet", "=", 
      RowBox[{"qHole", "+", "qElec"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eCoulOpt", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", "qElec", ")"}], ".", 
        RowBox[{"intmat", "[", "k", "]"}], ".", 
        RowBox[{"(", "qHole", ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"VcCT", "-", 
          RowBox[{"eFac", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Sqrt", "[", "Pi", "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"deltaCT", "/", "2"}], ")"}]}], ")"}]}]}], ")"}], ".", 
        RowBox[{"(", 
         RowBox[{"qElec", " ", "qHole"}], ")"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ePolzOpt", "=", 
      RowBox[{"qNet", ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"1", "/", "eps"}]}], ")"}], " ", 
         RowBox[{"intmat", "[", "k", "]"}]}], ")"}], ".", "qNet"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"eCoulOpt", "+", "ePolzOpt"}], ",", "eKEOpt", ",", "eCoulOpt", 
       ",", "ePolzOpt", ",", "elecKE", ",", "holeKE", ",", "psiEopt", ",", 
       "psiHopt"}], "}"}]}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.989173049405716*^9, 3.989173049410778*^9}, {
  3.989173087601676*^9, 3.9891730924669037`*^9}, {3.989173303918148*^9, 
  3.9891733170833387`*^9}, {3.9891743703458223`*^9, 3.9891743782503643`*^9}, {
  3.989175014606175*^9, 3.989175086931552*^9}, {3.990227957190188*^9, 
  3.9902279617914762`*^9}, {3.990266222694092*^9, 3.99026625595109*^9}, {
  3.99026640125379*^9, 3.9902664291931877`*^9}},
 CellLabel->
  "In[1853]:=",ExpressionUUID->"bd5ba2c6-a746-49bc-b162-3831e065088a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"results", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"CTSolve", "[", "k", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "237"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CTexcitonE", "=", 
   RowBox[{"results", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"OneBodyE", "=", 
   RowBox[{"results", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CoulombE", "=", 
   RowBox[{"results", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}]}], "Code",
 InitializationCell->True,
 CellChangeTimes->{{3.989173551369266*^9, 3.9891735672822733`*^9}, 
   3.994449575719685*^9},ExpressionUUID->"ba3132d8-bcf2-46be-adcd-\
53a7fc6cce70"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lm", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"OneBodyE", ",", "CTexcitonE"}], "}"}], "]"}], ",", "x", ",", 
     "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"residuals", "=", 
   RowBox[{"CTexcitonE", "-", 
    RowBox[{"lm", "/@", "OneBodyE"}]}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.990042428357254*^9, 3.990042428363254*^9}, 
   3.990220960220071*^9, {3.990221078760878*^9, 3.9902211001169558`*^9}},
 CellLabel->
  "In[1858]:=",ExpressionUUID->"e5138f48-cfb5-42ce-b132-4bf1d2abc04c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Cleaning Data", "Subsubsection",
 CellChangeTimes->{{3.990084273656588*^9, 
  3.99008427824109*^9}},ExpressionUUID->"8c4f05c6-1b1f-4f0c-a215-\
3de22dd856d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rho", "=", 
   RowBox[{"StandardDeviation", "[", "residuals", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"keepIdx", "=", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Position", "[", 
     RowBox[{
      RowBox[{"Abs", "[", "residuals", "]"}], ",", 
      RowBox[{"_", "?", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", "<=", 
          RowBox[{"1.8", "*", "rho"}]}], "&"}], ")"}]}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RemoveIds", "=", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Position", "[", 
     RowBox[{
      RowBox[{"Abs", "[", "residuals", "]"}], ",", 
      RowBox[{"_", "?", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", ">", 
          RowBox[{"1.8", "*", "rho"}]}], "&"}], ")"}]}]}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.990084280564432*^9, 3.990084298631484*^9}, {
  3.990084336984818*^9, 3.990084344862479*^9}, {3.990084381802973*^9, 
  3.990084391155449*^9}, {3.990084443922756*^9, 3.990084444757863*^9}, {
  3.990084516763645*^9, 3.9900845320794764`*^9}, {3.9900846333006983`*^9, 
  3.990084633708455*^9}, {3.9900847214199963`*^9, 3.990084733216058*^9}, {
  3.9900848852627497`*^9, 3.990084885533079*^9}, {3.990084979630458*^9, 
  3.9900849813648767`*^9}, {3.9902212159054737`*^9, 3.9902212175436983`*^9}, {
  3.9902215665110292`*^9, 3.990221566804167*^9}, {3.990221839415806*^9, 
  3.990221884659978*^9}, {3.990224594135322*^9, 3.990224595513809*^9}},
 CellLabel->
  "In[1864]:=",ExpressionUUID->"e21dacfe-7b09-4827-97ed-0438541d5413"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lm2", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"OneBodyE", "[", 
         RowBox[{"[", "keepIdx", "]"}], "]"}], ",", 
        RowBox[{"CTexcitonE", "[", 
         RowBox[{"[", "keepIdx", "]"}], "]"}]}], "}"}], "]"}], ",", "x", ",", 
     "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"residuals2", "=", 
   RowBox[{
    RowBox[{"CTexcitonE", "[", 
     RowBox[{"[", "keepIdx", "]"}], "]"}], "-", 
    RowBox[{"lm2", "/@", 
