Cell["\<\
Total CT exciton energy = Total Kinetic E + Coulomb E + Polarization E\
\>", "Text",
 CellChangeTimes->{{3.919525684582096*^9, 3.919525703089033*^9}, {
  3.919525806975842*^9, 
  3.919525863707773*^9}},ExpressionUUID->"9d923c9b-e26e-4dd2-8a69-\
16fac312243b"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"CTexctionE", "[", 
    RowBox[{"psiE_", ",", "psiH_", ",", "i_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "qElec", ",", "qHole", ",", "qNet", ",", "eKE", ",", "eCoul", ",", 
       "ePolz"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"qElec", "=", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"psiE", "^", "2"}], ")"}]}]}], ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"-", "ve"}], " ", "charge", " ", "distt"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"qHole", "=", 
       RowBox[{"psiH", "^", "2"}]}], ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"+", "ve"}], " ", "charge", " ", "distrution"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"qNet", "=", 
       RowBox[{"qHole", "+", "qElec"}]}], ";", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"total", " ", "charge", " ", "distribution"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"eKE", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"psiE", ".", 
          RowBox[{"matKEelecCT", "[", "i", "]"}], ".", "psiE"}], ")"}], " ", 
        "-", " ", 
        RowBox[{"(", 
         RowBox[{"psiH", ".", 
          RowBox[{"matKEholeCT", "[", "i", "]"}], ".", "psiH"}], ")"}]}]}], 
      ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"electron", " ", "KE"}], " ", "+", " ", 
        RowBox[{"hole", " ", "KE"}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"eCoul", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", "qElec", ")"}], ".", 
         RowBox[{"intmat", "[", "i", "]"}], ".", 
         RowBox[{"(", "qHole", ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"VcCT", "-", 
           RowBox[{"eFac", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Sqrt", "[", "Pi", "]"}], 
              RowBox[{"(", 
               RowBox[{"deltaCT", "/", "2"}], ")"}]}], ")"}]}]}], ")"}], ".", 
         
         RowBox[{"(", 
          RowBox[{"qElec", " ", "qHole"}], ")"}]}]}]}], ";", " ", "\n", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"offsite", " ", "coulomb", " ", "E"}], " ", "+", " ", 
        RowBox[{"onsite", " ", "correction", " ", "term"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"ePolz", "=", 
       RowBox[{"qNet", ".", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], "/", "2"}], 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"1", "/", "eps"}]}], ")"}], 
          RowBox[{"intmat", "[", "i", "]"}]}], ")"}], ".", "qNet"}]}], ";", 
      " ", 
      RowBox[{"(*", 
       RowBox[{
       "polarization", " ", "E", " ", "due", " ", "to", " ", "total", " ", 
        "charge", " ", "distribution"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"eKE", "+", "eCoul", "+", "ePolz"}]}]}], " ", 
    RowBox[{"(*", 
     RowBox[{"Total", " ", "exction", " ", "energy"}], "*)"}], 
    "\[IndentingNewLine]", "]"}]}], "Code"]], "Code",
