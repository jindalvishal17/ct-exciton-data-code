Cell[BoxData[
 RowBox[{
  RowBox[{"getCloseContactPosn", "[", "nThpair_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "seg1", ",", "seg2"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "b"}], "}"}], "=", 
      RowBox[{"GetCloseContactRingPair", "[", "nThpair", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"seg1", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ringCenter", "[", 
         RowBox[{"p3htAtoms", "[", "i", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"a", "-", "3"}], ",", 
          RowBox[{"a", "+", "3"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"seg2", "=", 
      RowBox[{"IDTBRringsCenter", "[", "b", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{"seg1", ",", "seg2"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
